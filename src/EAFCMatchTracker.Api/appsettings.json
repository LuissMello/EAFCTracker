{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning",
      "Microsoft.Hosting.Lifetime": "Information",
      "Microsoft.AspNetCore": "Warning",

      "System.Net.Http.HttpClient": "Information",
      "System.Net.Http": "Information",

      "Microsoft.EntityFrameworkCore.Database.Command": "Warning",
      "Microsoft.EntityFrameworkCore.Infrastructure": "Information",
      "Microsoft.EntityFrameworkCore.ChangeTracking": "Warning",

      "EAFCMatchTracker": "Debug"
    },
    "Console": {
      "FormatterName": "simple",
      "FormatterOptions": {
        "SingleLine": true,
        "IncludeScopes": true,
        "TimestampFormat": "HH:mm:ss "
      }
    }
  },

  "ConnectionStrings": {
    "Default": ""
  },
  "EAFCSettings": {
    "UseInMemoryDb": false,
    "BaseUrl": "https://proclubs.ea.com/api/fc",
    "SearchClubsEndpoint": "/allTimeLeaderboard/search?platform=common-gen5&clubName={0}",
    "SearchCurrentSeasonLeaderboardEndpoint": "/currentSeasonLeaderboard/search?platform=common-gen5&clubName={0}",
    "SearchAllTimeLeaderboardEndpoint": "/allTimeLeaderboard/search?platform=common-gen5&clubName={0}",
    "DivisionThresholdForAllTime": 5,
    "ClubStatsEndpoint": "/clubs/stats?clubIds={0}",
    "ClubMatchesEndpoint": "/clubs/matches?matchType={1}&platform=common-gen5&clubIds={0}&maxResultCount=20",
    "PlayerStatsEndpoint": "/members/stats?platform=common-gen5&clubId={0}",
    "OverallStatsEndpoint": "/clubs/overallStats?platform=common-gen5&clubIds={0}",
    "PlayoffHistoryEndpoint": "club/playoffAchievements?platform=common-gen5&clubId={0}",
    "MembersStatsEndpoint": "/members/stats?platform=common-gen5&clubId={0}"
  },
  "Auth": {
    // Senha do administrador (também aceita no header X-Api-Key por scripts). NÃO versionar o valor real:
    // defina via env Auth__ApiKey (fly secrets set Auth__ApiKey=...). Trocar a senha invalida todos os tokens.
    // Vazia: em Development as rotas protegidas ficam abertas; fora dele, login=503 e rotas protegidas=401.
    "ApiKey": "",
    // Duração do token de sessão emitido por POST /api/auth/login (horas, limitado a 1..168; padrão 12).
    "TokenHours": 12
  },
  "Cors": {
    "AllowedOrigins": [ "https://luissmello.github.io", "http://localhost:3000" ]
  }
}
